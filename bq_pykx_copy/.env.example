# =============================================================================
# Copy this file to `.env` and fill in the values.  `.env` is git-ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# PyKX license  (>>> PASTE YOUR LICENSE HERE <<<)
# -----------------------------------------------------------------------------
# PyKX reads the license from these environment variables (verified against the
# PyKX install docs):
#   * KDB_LICENSE_B64     -> base64 contents of a personal kc.lic (pykx-enabled)
#   * KDB_K4LICENSE_B64   -> base64 contents of a commercial k4.lic
# Alternatively drop the raw kc.lic file into this folder (bq_pykx_copy/kc.lic)
# and leave KDB_LICENSE_B64 blank - the scripts auto-detect ./kc.lic via QLIC.
#
# Get a free personal license:
#   https://kx.com/kdb-insights-personal-edition-license-download/
KDB_LICENSE_B64=
KDB_K4LICENSE_B64=

# -----------------------------------------------------------------------------
# GCP target  (auth is via your current `gcloud`/ADC login - no keys needed)
# -----------------------------------------------------------------------------
# Leave GCP_PROJECT blank to fall back to your ADC default project.
GCP_PROJECT=
GCS_BUCKET=your-project-id-kdb-migration-poc
GCS_PREFIX=kdb_migration_poc
BQ_DATASET=kdb_migration_poc
BQ_TABLE=firm_orderbook_poc
BQ_LOCATION=US

# -----------------------------------------------------------------------------
# Data-generation / run knobs
# -----------------------------------------------------------------------------
# Worst-case customer partition is ~7,000,000 rows. Keep the first run small.
POC_ROWS=1000000
# Comma-separated partition dates (YYYY.MM.DD in kdb form) to generate.
POC_DATES=2024.01.02,2024.01.03
# Parquet row-group size (rows). Lower = less peak RAM, more overhead.
PARQUET_ROW_GROUP=250000
