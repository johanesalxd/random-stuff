# --- Shared (both default and advanced paths) ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number
GOOGLE_CLOUD_LOCATION=global
BIGQUERY_LOCATION=us
DATAPLEX_LOCATION=us
BIGQUERY_DATASET_ID=thelook_ecommerce
AGENT_ORDERS_ID=order_user_agent
AGENT_INVENTORY_ID=inventory_product_agent
# Dataset-wide CA data agent over the full thelook dataset, used as the semantic
# workflow's fallback (see SEMANTIC_FALLBACK_MODE). Created by scripts/admin_tools.py.
AGENT_SEMANTIC_CA_ID=semantic_ca_agent

# Dataplex metadata enrichment settings. Used by
# scripts/enrich_bigquery_metadata.py to run data profile scans, table insights,
# and dataset insights for the same BigQuery assets used by CA API data agents.
DATAPLEX_SCAN_PREFIX=bq-caapi
DATA_PROFILE_MODE=STANDARD
DATA_PROFILE_SAMPLING_PERCENT=10
# DATA_PROFILE_RESULTS_TABLE=your-project-id.metadata.profile_results

# Gemini Enterprise app ID. Used by scripts/register_ge_agents.py to register
# CA API data agents in GE via the Discovery Engine API.
# Find this in the GE console URL or by listing engines via the Discovery Engine API.
GEMINI_APP_ID=your-gemini-app-id

# OAuth client credentials -- required to create authorization resources in GE.
# Download the OAuth client JSON from GCP Console > APIs & Services > Credentials,
# then copy client_id and client_secret here.
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Authorization Resource IDs
# Note: Gemini Enterprise requires a 1:1 mapping between agents and auth resources.
# Session state keys where Gemini Enterprise deposits each user's OAuth token.
# Must match the authorizationId values used when running
# scripts/register_ge_agents.py or advanced/scripts/setup_auth.py.
AUTH_RESOURCE_ORDERS=bq-caapi-oauth-orders
AUTH_RESOURCE_INVENTORY=bq-caapi-oauth-inventory

# --- Advanced path only (ADK runtime + Agent Engine deployment) ---
# See advanced/README.md for details.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
MODEL_NAME=gemini-3.5-flash
# Portable semantic context file or directory. A directory loads all .yaml and
# .yml contracts in deterministic path order on each request.
SEMANTIC_CONTRACT_PATH=config/semantic_contracts
# Local ADK API server settings for the test web app.
# ADK_LOCAL_BASE_URL=http://127.0.0.1:8000
# ADK_LOCAL_APP_NAME=semantic_analytics
# Set after running: bash advanced/scripts/deploy_agents.sh
# ORDERS_REASONING_ENGINE_ID=your-orders-reasoning-engine-id
# INVENTORY_REASONING_ENGINE_ID=your-inventory-reasoning-engine-id
# Vertex AI Agent Engine region for deploy_agents.sh and the test web app.
# Distinct from GOOGLE_CLOUD_LOCATION=global (Discovery Engine), which is not a
# valid Vertex region.
# AGENT_ENGINE_LOCATION=us-central1

# --- Semantic analytics workflow (advanced/app/semantic_analytics) ---
# All values below have safe defaults; uncomment to override.
# SQL execution stage. plan (default) stops after a successful dry run; developer
# executes the read-only, cost-capped query as the final step.
# SQL_EXECUTION_MODE=plan
# Whose credentials run the query. adc (default) uses Application Default
# Credentials; user binds each query to the per-request OAuth token and fails
# closed when it is absent. Any multi-user deployment must set this to user.
# SQL_AUTH_MODE=adc
# Cost and result guardrails enforced by the ADK BigQuery executor.
# SQL_MAX_BYTES_BILLED=100000000
# SQL_MAX_RESULT_ROWS=50
# Session-state key the workflow reads the user OAuth token from. Must match the
# harness ADK_OAUTH_TOKEN_STATE_KEY and the deployed agent's authorization key.
# ADK_OAUTH_TOKEN_STATE_KEY=AUTH_RESOURCE_SEMANTIC_ANALYTICS

# Broad catalog discovery allowlists. These are default-deny: with neither set,
# the broad path fails closed and returns no discovered sources. Narrow grounding
# does not need them (it uses the sources named in the semantic contract).
# CATALOG_ALLOWED_PROJECTS=bigquery-public-data
# CATALOG_ALLOWED_DATASETS=bigquery-public-data.thelook_ecommerce
# Opt into Dataplex Catalog search and structural, value-free profile enrichment.
# When off (default), broad discovery uses BigQuery name-match enumeration.
# CATALOG_DATAPLEX_ENABLED=false

# --- Flask test harness (advanced/test_web) ---
# Stable secret keeps signed session cookies valid across restarts; an ephemeral
# one is generated with a warning when unset.
# FLASK_SECRET_KEY=change-me
# Set to 1 to mark session cookies Secure when serving over HTTPS.
# COOKIE_SECURE=0
