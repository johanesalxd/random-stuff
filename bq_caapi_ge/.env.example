# ==============================================================================
# (1) Core GCP & Locations
# ==============================================================================
GOOGLE_CLOUD_PROJECT=your-project-id
# Optional compute / billing project override when the BigQuery job billing project
# differs from GOOGLE_CLOUD_PROJECT (uncomment only if needed):
# BQ_COMPUTE_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number

# ------------------------------------------------------------------------------
# GCP Location Alignment Guide (5 distinct location variables):
#   1. GOOGLE_CLOUD_LOCATION: CA API endpoint location ('global', 'us', 'eu', 'asia-southeast1').
#   2. BIGQUERY_LOCATION: BigQuery dataset storage & query execution region ('US', 'EU', 'us-central1').
#   3. AGENT_ENGINE_LOCATION: Vertex AI Agent Engine regional deployment endpoint ('us-central1').
#   4. DATAPLEX_LOCATION: Knowledge Catalog metadata scan region (must be regional, e.g. 'us-central1').
#   5. GEMINI_APP_LOCATION: Gemini Enterprise (Discovery Engine) app location ('global', 'us', 'eu').
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_LOCATION=global
GEMINI_APP_LOCATION=global
AGENT_ENGINE_LOCATION=us-central1
BIGQUERY_LOCATION=us
DATAPLEX_LOCATION=us-central1
BIGQUERY_DATASET_ID=your-dataset-id

# ==============================================================================
# (2) Semantic Runtime & Guardrails (advanced/app/semantic_analytics)
# ==============================================================================
GOOGLE_GENAI_USE_VERTEXAI=TRUE
SEMANTIC_SELECTOR_MODEL=gemini-3.5-flash
SQL_GENERATOR_MODEL=claude-sonnet-4-5
RESULT_SUMMARIZER_MODEL=gemini-3.5-flash

# Portable semantic context path (file or directory of YAML contracts)
SEMANTIC_CONTRACT_PATH=config/semantic_contracts

# BigQuery execution auth mode:
#   'adc': Application Default Credentials (shared identity for local tests & eval benchmarks)
#   'user': End-user OAuth bearer token passed per-request via ADK session state
#   'impersonated_sa': Allowlisted role-based SA impersonation verified via signed role assertion
SQL_AUTH_MODE=adc

# Deployment target auth mode for deploy_agents.sh ('user' or 'impersonated_sa'; 'adc' is rejected)
DEPLOY_SQL_AUTH_MODE=user

# Impersonated SA & Row-Level Security (RLS) Configuration (for SQL_AUTH_MODE=impersonated_sa):
# State key where caller gateway passes the signed role assertion token
ADK_ROLE_ASSERTION_STATE_KEY=bq-caapi-role-assertion

# Expected audience claim for verified role assertions
SQL_ROLE_ASSERTION_AUDIENCE=bq-caapi-rls

# In production (Agent Engine): Trusted caller Gateway SA whose RS256 OIDC signature is verified by Agent Engine.
# Uncomment in production, or leave commented and set SQL_ROLE_ASSERTION_HMAC_SECRET for local adk run testing:
# SQL_ROLE_TRUSTED_CALLER_SA=gateway-runner@your-project-id.iam.gserviceaccount.com

# Allowlisted mapping of role slugs to customer-managed Role Service Accounts (single-quoted compact JSON)
SQL_ROLE_SA_MAP_JSON='{"apac_analyst":"role-apac@your-project-id.iam.gserviceaccount.com","emea_analyst":"role-emea@your-project-id.iam.gserviceaccount.com"}'

# Impersonated short-lived credentials lifetime in seconds (60 to 3600; default 300)
SQL_IMPERSONATION_LIFETIME_SECONDS=300

# Maximum role assertion TTL in seconds (enforces exp - iat <= max_ttl; default 900)
SQL_ROLE_ASSERTION_MAX_TTL_SECONDS=900

# Local development and testing only: Shared HMAC-SHA256 secret (minimum 32 characters)
# NEVER set this in production or deploy it to Agent Engine!
# SQL_ROLE_ASSERTION_HMAC_SECRET=your-secure-local-dev-hmac-secret-at-least-32-chars

# Query safety guardrails: pre-execution dry-run byte cap (e.g. 1GB) and max result rows
SQL_MAX_BYTES_BILLED=1000000000
SQL_MAX_RESULT_ROWS=50

# Broad Knowledge Catalog discovery default-deny allowlists
CATALOG_ALLOWED_PROJECTS=bigquery-public-data
CATALOG_ALLOWED_DATASETS=bigquery-public-data.thelook_ecommerce

# Gemini Enterprise / Agent Engine authorization resource and deployed engine ID
AUTH_RESOURCE_SEMANTIC_ANALYTICS=bq-caapi-oauth-semantic
ADK_OAUTH_TOKEN_STATE_KEY=bq-caapi-oauth-semantic
SEMANTIC_REASONING_ENGINE_ID=

# Optional local ADK API server settings for the test web app
# ADK_LOCAL_BASE_URL=http://127.0.0.1:8000
# ADK_LOCAL_APP_NAME=semantic_analytics

# Test web app (advanced/test_web) session secrets
# FLASK_SECRET_KEY=change-me
# COOKIE_SECURE=0

# ==============================================================================
# (3) Baseline OOTB BQCA & Gemini Enterprise OAuth
# ==============================================================================
AGENT_ORDERS_ID=order_user_agent
AGENT_INVENTORY_ID=inventory_product_agent
GEMINI_APP_ID=your-gemini-app-id

# OAuth client credentials for user delegation in Gemini Enterprise
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Per-agent auth resources for baseline CA API data agents
AUTH_RESOURCE_ORDERS=bq-caapi-oauth-orders
AUTH_RESOURCE_INVENTORY=bq-caapi-oauth-inventory

# Maximum bytes billed during eval benchmarks
EVAL_MAXIMUM_BYTES_BILLED=1000000000

# Knowledge Catalog metadata enrichment settings (scripts/enrich_bigquery_metadata.py)
DATAPLEX_SCAN_PREFIX=bq-caapi
DATA_PROFILE_MODE=STANDARD
DATA_PROFILE_SAMPLING_PERCENT=10
