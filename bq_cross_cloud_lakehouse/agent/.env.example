# Froyo Lakehouse CA Agent -- configuration TEMPLATE (safe to commit).
#
# Copy this to `.env` and fill in real values. `.env` is git-ignored.
#
#     cp .env.example .env
#
# INFRASTRUCTURE VALUES ARE NOT DUPLICATED HERE. The scripts load the demo's
# `../config.local.env` first (single source of truth for the BigQuery project,
# region, federated catalog, Glue database, and table names), then this file for
# the Gemini Enterprise / OAuth / agent settings below. Run the lakehouse
# `aws/*` + `gcp/*` pipeline before deploying this agent so the datasets exist.
#
# From ../config.local.env the scripts consume:
#   GCP_PROJECT, GCP_REGION, FEDERATED_CATALOG, GLUE_DATABASE,
#   FROYO_NATIVE_DATASET, FROYO_LOYALTY_TABLE, FROYO_SALES_TABLE

# ---- CA API data agent ----
# CA API resource location. "global" works for most projects. If your regional
# (us-east4) data requires a regional endpoint, set this to us-east4 and the
# scripts automatically switch to the matching regional API endpoints.
GOOGLE_CLOUD_LOCATION=global

# The CA API data agent ID created by scripts/create_agent.py.
AGENT_ID=froyo_lakehouse_analyst

# ---- Gemini Enterprise integration (scripts/register_ge_agent.py) ----
GEMINI_APP_ID=your-gemini-app-id

# Gemini Enterprise / Discovery Engine app location. Independent of the CA agent
# location above -- GE apps are almost always "global". Only change this if your
# GE app lives in a specific region.
GEMINI_APP_LOCATION=global

# Required to build the agent authorization resource path in GE.
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number

# OAuth client credentials -- required to create the GE authorization resource.
# Download the OAuth client JSON from GCP Console > APIs & Services > Credentials.
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Authorization resource ID attached to the agent in Gemini Enterprise (1:1).
AUTH_RESOURCE=froyo-lakehouse-oauth

# ---- Metadata enrichment showcase (scripts/enrich_bigquery_metadata.py) ----
# OPTIONAL. Runs Dataplex data profile + data documentation scans on the agent's
# tables to show BigQuery/Knowledge Catalog already generate this metadata. Not
# required to run the agent, and intentionally NOT wired into the agent context.

# Region where the Dataplex scans run. Must match the data region. Defaults to
# GCP_REGION (from ../config.local.env), i.e. us-east4.
# DATAPLEX_LOCATION=us-east4

# Prefix for the created DataScan resource ids (kept distinct from the PDF
# discovery scan froyo-profile-stg1).
# DATAPLEX_SCAN_PREFIX=froyo-agent

# Data profile execution mode: STANDARD (default) or LIGHTWEIGHT.
# DATA_PROFILE_MODE=STANDARD
